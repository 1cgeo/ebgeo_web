# ==============================================================================
# Raiz do monorepo. O que é de um pacote mora no .gitignore DELE
# (frontend/.gitignore, backend/.gitignore); aqui fica só o que atravessa os dois.
# Cuidado: padrão com barra no meio (`public/3d/`) é ancorado no arquivo que o
# declara, então padrão de pacote escrito aqui silenciosamente deixa de casar.
# ==============================================================================

# Dependências
# Lockfile não é versionado neste projeto (convenção pré-existente); cada pacote
# ignora o seu, e a raiz ignora o dela.
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.node_repl_history

# Ambiente
.env

# Deploy (artefatos gerados no host, o deploy.sh é versionado)
deploy/releases/
deploy/current

# Logs e PIDs
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock

# Editores e SO
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store

# Agente (Claude Code)
# Permissões locais por desenvolvedor: caminho de máquina e domínios liberados
# em pesquisas pontuais. O que vale para o time mora em .claude/settings.json.
.claude/settings.local.json
