# Test environment configuration
# This file is used for running tests with test:quick (manual DB management)

NODE_ENV=test
DATABASE_URL=postgresql://ebgeo:ebgeo_secret@localhost:5432/ebgeo_test
JWT_SECRET=test-secret-key-for-testing-purposes-only-32chars
IMAGES_DIR=./data/test-images
# Caminho PROPRIO para o acervo 3D: um teste apaga este arquivo, e o default e o de
# desenvolvimento (ver o comentario em scripts/run-tests.js).
ASSETS_3D_SQLITE=./data/test-assets3d.sqlite
LOG_LEVEL=error
