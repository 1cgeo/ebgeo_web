{
  "name": "ebgeo-backend",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "db:setup": "node --env-file-if-exists=.env scripts/dev-db.js create",
    "db:migrate": "node --env-file-if-exists=.env src/database/migrate.js",
    "db:seed": "node --env-file-if-exists=.env src/database/seed.js",
    "db:test:create": "node scripts/test-db.js create",
    "db:test:drop": "node scripts/test-db.js drop",
    "db:test:reset": "node scripts/test-db.js reset",
    "test": "node scripts/run-tests.js",
    "test:coverage": "c8 node scripts/run-tests.js",
    "test:keep-db": "node scripts/run-tests.js --keep-db",
    "test:unit": "node scripts/run-tests.js tests/unit/**/*.test.js",
    "test:integration": "node scripts/run-tests.js tests/integration/**/*.test.js",
    "test:ws": "node scripts/run-tests.js tests/ws/**/*.test.js",
    "test:quick": "node --test --env-file=.env.test tests/**/*.test.js",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"**/*.{js,json,md}\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "file-type": "^22.0.1",
    "helmet": "^8.0.0",
    "joi": "^17.13.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg-promise": "^12.5.0",
    "pino": "^8.21.0",
    "pino-pretty": "^11.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mapbox/vector-tile": "^3.0.0",
    "c8": "^11.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "pbf": "^5.1.0",
    "prettier": "^3.8.4",
    "supertest": "^6.3.3"
  }
}
