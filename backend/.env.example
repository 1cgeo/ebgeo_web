# Copie para `.env` na raiz de backend/ (`cp .env.example .env`) e ajuste.
#
# TOPOLOGIA DE DEV — as portas NÃO são arbitrárias:
#   frontend (Vite)  :3000   — vite.config.js `server.port`
#   backend          :8080   — alvo do proxy `/api` do Vite (vite.config.js `server.proxy`)
# O Vite serve o app e faz proxy de `/api` para o backend, então o browser fala com uma
# origem só. Inverter as portas faz o proxy apontar para o vazio e o app cai na tela
# "EBGeo indisponível" (o boot é fail-fast em GET /api/config — ver src/js/index.js).

# Server
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Log em ARQUIVO: um .jsonl por dia em LOG_DIR, podado por idade. É o que faz a evidência
# de um defeito sobreviver ao fechamento do terminal (ou do container). Vale em dev também.
# Para desligar, o valor tem de ser exatamente `off`: vazio cai no default.
LOG_TO_FILE=on
LOG_DIR=./data/logs
LOG_RETENTION_DAYS=30

# Amostra periódica de SAÚDE (src/utils/amostra-de-saude.js): uma linha no log a cada
# intervalo, com marcador `amostra: "saude"`, dizendo se o banco respondeu e em quanto tempo,
# quanto do pool está em uso, memória, uptime e sockets de colaboração vivos. É a metade que
# PERGUNTA sozinha; o GET /api/v1/health só responde a quem chama, e aqui não há orquestrador
# chamando. Para desligar, o valor tem de ser exatamente `off` (vazio cai no default). Nunca
# sobe em teste.
#
# LIMITE HONESTO: um amostrador dentro do processo NÃO testemunha a própria morte. Quem
# revela uma queda é o BURACO na série, não uma amostra dizendo que caiu.
#
# 300000 ms = 5 min: 288 pontos/dia (dois faltando já localizam a queda numa janela de dez
# minutos) sem que a sonda dispute o pool com o sync. O prazo da sonda é próprio e maior que
# o do /health porque esta escreve história e precisa distinguir "lento" de "morto".
HEALTH_SAMPLE=on
HEALTH_SAMPLE_INTERVAL_MS=300000
HEALTH_SAMPLE_DB_TIMEOUT_MS=5000

# Database
DATABASE_URL=postgresql://ebgeo:ebgeo_secret@localhost:5432/ebgeo
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Images
IMAGES_DIR=./data/images
MAX_IMAGE_SIZE_MB=10
# Dedicated body limit for POST /images/bulk (base64 batch); > global JSON limit
MAX_BULK_UPLOAD_MB=50

# WebSocket
WS_HEARTBEAT_INTERVAL_MS=30000
WS_HEARTBEAT_TIMEOUT_MS=5000
# Grace window (ms) before an abnormally-dropped user is removed from presence
# (Fase 8 away/remove); a reconnect with the same clientId cancels removal.
WS_AWAY_GRACE_MS=120000

# Security / hardening
# Self-registration: off by default in production, on in dev/test. Set to 'true'/'false' to override.
ALLOW_SELF_REGISTRATION=
# Rate limiting (credential routes + public link)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=30
# Teto de POST /auth/register por ENDEREÇO (o limiter de credencial acima chaveia
# por ip+username, e num cadastro o username é escolhido pelo chamador: balde novo a
# cada requisição). Janela de 1 h e teto de 20 é palpite calibrado, não medição —
# errar para baixo numa OM inteira atrás de NAT vira "o EBGeo não deixa ninguém se
# cadastrar".
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REGISTER_MAX=20

# E-mail (link de confirmação de conta)
# O auto-cadastro EXIGE e-mail: a conta nasce pendente e só o link `?verify=` a ativa.
# Sem SMTP_HOST o mailer degrada para no-op que LOGA o link — modo esperado em dev e
# em rede fechada, silencioso e inútil em produção. Por isso, EM PRODUÇÃO COM
# AUTO-CADASTRO LIGADO, SMTP_HOST e APP_BASE_URL são exigidos no boot (o servidor
# recusa subir sem eles). Ordem de implantação: configurar o relay primeiro, subir, e
# só então mexer em ALLOW_SELF_REGISTRATION.
# APP_BASE_URL vazio produz link RELATIVO (inútil dentro de um e-mail): a origem do
# cliente só é honrada quando é idêntica a CORS_ORIGIN.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@ebgeo.local
APP_BASE_URL=
# TTL do token de confirmação, em horas (default 48).
AUTH_VERIFICATION_TTL_HOURS=48
# TTL do CÓDIGO de redefinição de senha, em MINUTOS (default 60, teto de 1440).
# Muito mais curto que o de confirmação de propósito: o de confirmação ativa um
# endereço já declarado, este troca o único fator de autenticação da casa.
# As rotas /auth/forgot-password e /auth/reset-password só são montadas onde a
# mensagem pode chegar: com SMTP_HOST configurado, ou fora de produção (onde o
# mailer escreve o código no log e o log é o canal). Em produção sem relay elas
# não sobem, GET /api/v1/config reporta features.password_reset_email falso, e a
# tela de login oferece só o caminho do administrador.
AUTH_PASSWORD_RESET_TTL_MINUTES=60

# Runtime app config (GET /api/v1/config) — service & tile URLs.
# Defaults below are PUBLIC DEV-ONLY placeholders; in production (rede militar)
# replace with internal DGEO servers.
TILE_SERVER_URL=
TERRAIN_URL=https://demotiles.maplibre.org/terrain-tiles/tiles.json
HILLSHADE_URL=https://demotiles.maplibre.org/terrain-tiles/tiles.json
MAP3D_IMAGERY_URL=https://a.tile.openstreetmap.org/{z}/{x}/{y}.png
# Terreno do Cesium (deploy). VAZIO = sem terreno (elipsoide plano). Em produção
# costuma ser um caminho RELATIVO servido pelo mesmo proxy, ex.: /cms/terrain-cesium/
MAP3D_TERRAIN_URL=

# Min/maxzoom das fontes raster-dem. Só se aplicam quando a URL acima é um
# TEMPLATE `{z}/{x}/{y}` (fonte por tiles); numa URL TileJSON o próprio manifesto
# declara os zooms. Ex. de deploy real: /cms/martin/fathom_terrain/{z}/{x}/{y}
# TERRAIN_MINZOOM=0
# TERRAIN_MAXZOOM=12
# HILLSHADE_MINZOOM=8
# HILLSHADE_MAXZOOM=12
# StreetView 360 is ABSORBED into this backend (Fase 9) — no external :8081 service.
# serviceUrl = the in-backend mount. The frontend consumes a server-rendered VECTOR
# source: the MVT tiles at ${SV360_SERVICE_URL}/tiles/{z}/{x}/{y}.pbf (PostGIS
# ST_AsMVT), with the 'fotos' (points) and 'fotos_linha' (per-project trajectory
# lines) layers. GeoJSON-as-source and PMTiles are DISCONTINUED; only the service
# base is configured here (the {z}/{x}/{y} are MapLibre placeholders, not env).
SV360_SERVICE_URL=/api/v1/sv360
# 3D assets (tiles/glb). Served SQLite-first, then filesystem.
ASSETS_3D_DIR=./data/assets3d
# Base URL exposed in GET /api/config as `assets3dBaseUrl` (frontend resolves
# relative asset URLs against it; point at an internal host in production).
ASSETS_3D_BASE_URL=/api/v1/assets3d
ASSETS_3D_SQLITE=./data/assets3d.sqlite
ASSETS_3D_MAX_INFLIGHT=8
# Worker threads that read SQLite BLOBs off the main loop (default: cpus-1, max 4)
SQLITE_BLOB_WORKERS=

# StreetView 360 (Fase 9) — per-project {slug}.db SQLite stores hold the WebP
# BLOBs; metadata + *_size_bytes live in Postgres (schema sv360). Mirrors assets3d.
SV360_DB_DIR=./data/sv360
SV360_MAX_INFLIGHT=8
# Bundle ingestion (stage 3a): multer tmp MUST be on the same volume as SV360_DB_DIR
# (atomic .tmp->dest rename); max multipart size for the (multi-GB) images.db.
SV360_TMP_DIR=./data/sv360-tmp
# Max multipart upload (images.db). Default 2 GiB — bounds the authenticated
# disk-fill blast radius (FIX-4). Keep the NGINX client_max_body_size in sync.
SV360_MAX_UPLOAD_BYTES=2147483648

# Basemap tile/style URLs (substitute with internal servers in production)
OSM_TILE_URL=https://a.tile.openstreetmap.org/{z}/{x}/{y}.png
MAPLIBRE_GLYPHS_URL=https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf
IMAGENS_TILE_URL=https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}
ORTOIMAGEM_TILE_URL=
BDGEX_WMS_URL=

# PROXY REVERSO
#
# Quantos saltos de proxy confiar no X-Forwarded-For. Default 1, que casa com o NGINX
# único do deploy documentado. Ele decide o que `req.ip` vale, e `req.ip` decide DUAS
# coisas: a parte de endereço da chave do limitador de taxa e o campo `ip` de toda linha
# de requisição no log.
#
# O modo de falha não é ruidoso. Com o número maior que a realidade, o cliente escolhe o
# endereço que quiser escrevendo o cabeçalho; com o número menor, toda linha do log traz
# o MESMO endereço (o do proxy), que é pior do que não ter o campo, porque tem cara de
# medição. Com a app exposta direto, sem proxy nenhum, o valor certo é 0.
TRUST_PROXY_HOPS=1
