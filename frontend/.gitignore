# Dependências (package-lock.json É versionado — ver .gitignore da raiz)
node_modules/

# Build
dist/
src_total

# Playwright (E2E de browser em tests/e2e-ui/)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.playwright/

# Testes e qualidade
coverage/
.eslintcache

