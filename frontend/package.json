{
  "name": "ebgeo",
  "version": "1.0.0",
  "description": "EBGeo: pacote web (Vanilla JS + Vite + MapLibre + Cesium + Three.js).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "clean": "rm -rf dist node_modules/.vite",
    "knip": "knip",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "node eslint-rules/probe.js && eslint . --max-warnings 0",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .gitignore",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
    "lint:js:fix": "eslint . --fix",
    "lint:css:fix": "stylelint \"**/*.css\" --fix --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.js",
    "test:e2e:ui": "playwright test",
    "test:e2e:mega": "playwright test browser-collab-mega --headed",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:tablet": "playwright test --config playwright.tablet.config.js",
    "test:e2e:atlas": "playwright test --config playwright.atlas-safety.config.js",
    "test:e2e:migracao": "playwright test --config playwright.migration-data.config.js",
    "test:e2e:sessao-longa": "playwright test --config playwright.release-long-session.config.js",
    "test:e2e:atlas-grande": "playwright test --config playwright.release-large-atlas.config.js",
    "test:e2e:ida-e-volta": "node tests/helpers/main-round-trip.mjs"
  },
  "dependencies": {
    "@manycore/aholo-viewer": "1.8.1",
    "@tmcw/togeojson": "^7.1.2",
    "@turf/turf": "7.4.0",
    "cesium": "1.145.0",
    "chart.js": "^4.5.1",
    "docsify": "5.0.0",
    "dompurify": "3.4.13",
    "gdal3.js": "2.8.1",
    "geomagnetism": "^0.2.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "maplibre-gl": "6.11.2",
    "mgrs": "^2.1.0",
    "milsymbol": "3.0.4",
    "proj4": "^2.20.2",
    "quill": "2.0.2",
    "shpjs": "^6.2.0",
    "sortablejs": "^1.15.6",
    "suncalc": "2.0.2",
    "three": "0.164.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@vitejs/plugin-legacy": "^8.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.17.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.8.0",
    "globals": "^15.14.0",
    "knip": "^5.40.0",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "terser": "^5.31.0",
    "typescript": "^5.5.4",
    "vite": "^8.1.2",
    "vitest": "^4.1.11"
  },
  "author": "1Âº Centro de GeoinformaÃ§Ã£o",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "brace-expansion": "1.1.18",
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18"
  }
}
