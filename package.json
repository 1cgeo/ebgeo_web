{
  "name": "ebgeo-monorepo",
  "version": "1.0.0",
  "description": "EBGeo: GIS web do Exercito Brasileiro. Raiz do monorepo (frontend/ + backend/).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -n backend,web -c blue,green \"npm:dev:backend\" \"npm:dev:web\"",
    "dev:web": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend",
    "deploy": "./deploy/deploy.sh",
    "lint": "npm run lint --prefix frontend",
    "lint:fix": "npm run lint:fix --prefix frontend",
    "lint:backend": "npm run lint --prefix backend",
    "lint:all": "npm run lint && npm run lint:backend",
    "test": "npm test --prefix frontend",
    "test:watch": "npm run test:watch --prefix frontend",
    "test:coverage": "npm run test:coverage --prefix frontend",
    "test:backend": "npm test --prefix backend",
    "test:all": "npm test && npm run test:backend",
    "test:e2e": "npm run test:e2e --prefix frontend",
    "test:e2e:ui": "npm run test:e2e:ui --prefix frontend",
    "test:e2e:mega": "npm run test:e2e:mega --prefix frontend",
    "knip": "npm run knip --prefix frontend",
    "clean": "npm run clean --prefix frontend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
