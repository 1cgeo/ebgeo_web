{
  "name": "ebgeo",
  "version": "1.0.0",
  "description": "Sistema de Informação Geográfica do Exército Brasileiro",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node ./server/server.cjs",
    "clean": "rm -rf dist node_modules/.vite",
    "knip": "knip",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .gitignore",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
    "lint:js:fix": "eslint . --fix",
    "lint:css:fix": "stylelint \"**/*.css\" --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.2",
    "chart.js": "^4.5.1",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "mgrs": "^2.1.0",
    "proj4": "^2.20.2",
    "quill": "^2.0.3",
    "restify": "^11.1.0",
    "shpjs": "^6.2.0",
    "sortablejs": "^1.15.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-legacy": "^5.4.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "knip": "^5.40.0",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "terser": "^5.31.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "author": "1º Centro de Geoinformação",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  }
}
